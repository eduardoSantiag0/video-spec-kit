{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generation Config",
  "description": "generation-config.yaml — everything needed to reproduce a generation. One entry per adapter/model run. Model-specific parameters go in `params`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "scene_id", "version", "runs"],
  "properties": {
    "spec_version": { "$ref": "common.schema.json#/$defs/specVersion" },
    "scene_id": { "$ref": "common.schema.json#/$defs/sceneId" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adapter", "status", "model", "prompt_file", "width", "height", "num_frames", "fps"],
        "properties": {
          "id": { "type": "string", "description": "Unique within the file, e.g. 'wan-1'." },
          "adapter": { "$ref": "common.schema.json#/$defs/kebabId" },
          "status": { "enum": ["planned", "generated", "discarded"] },
          "model": { "type": "string", "description": "Model family/checkpoint, e.g. 'Wan2.2-T2V-A14B'." },
          "model_version": { "type": "string" },
          "tool": { "type": "string", "description": "ComfyUI, diffusers, official repo CLI..." },
          "workflow": { "type": "string", "description": "Workflow name/file and its version." },
          "prompt_file": { "type": "string" },
          "negative_prompt_file": { "type": "string" },
          "prompt_override": { "type": "boolean", "description": "True if the prompt was hand-edited and is not a pure compile of the spec." },
          "prompt_override_reason": { "type": "string" },
          "seed": { "type": ["integer", "null"] },
          "width": { "type": "integer", "minimum": 64 },
          "height": { "type": "integer", "minimum": 64 },
          "num_frames": { "type": "integer", "minimum": 1 },
          "fps": { "type": "integer", "minimum": 1 },
          "steps": { "type": "integer", "minimum": 1 },
          "cfg": { "type": "number", "minimum": 0 },
          "sampler": { "type": "string" },
          "scheduler": { "type": "string" },
          "reference_images": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/referenceImage" } },
          "params": { "type": "object", "description": "Any other model/tool parameter (shift, lora, strength, upscaler...).", "additionalProperties": true },
          "output": { "type": "string", "description": "Path to the generated video, if saved." },
          "generated_at": { "type": "string", "description": "ISO date of the generation." },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
