{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene Spec",
  "description": "scene-spec.yaml — the source of truth for one scene version. See kit/conventions.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "id",
    "version",
    "title",
    "idea",
    "intent",
    "format",
    "subjects",
    "environment",
    "camera",
    "provenance"
  ],
  "properties": {
    "spec_version": {
      "$ref": "common.schema.json#/$defs/specVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/sceneId"
    },
    "project": {
      "$ref": "common.schema.json#/$defs/kebabId"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "idea": {
      "type": "string",
      "description": "The user's original idea — or, for screenplay-derived scenes, the excerpt lines this shot covers — verbatim, in the original language."
    },
    "idea_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "Language of `idea` (BCP 47, e.g. 'en', 'pt-BR'). Everything else in the spec is English."
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "intent": {
      "type": "string",
      "description": "What the viewer should feel or understand. Used to break ties."
    },
    "presets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Preset ids per kind. Explicit scene values override preset values.",
      "properties": {
        "style": {
          "$ref": "common.schema.json#/$defs/kebabId"
        },
        "camera": {
          "$ref": "common.schema.json#/$defs/kebabId"
        },
        "lighting": {
          "$ref": "common.schema.json#/$defs/kebabId"
        }
      }
    },
    "format": {
      "$ref": "common.schema.json#/$defs/format"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action"
        ],
        "anyOf": [
          {
            "required": [
              "character_id"
            ]
          },
          {
            "required": [
              "description"
            ]
          }
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/kebabId",
            "description": "Local id inside the scene."
          },
          "character_id": {
            "$ref": "common.schema.json#/$defs/kebabId",
            "description": "Reference to characters/<id>.yaml."
          },
          "description": {
            "type": "string",
            "description": "Inline appearance when no character file is used, or scene-specific additions."
          },
          "action": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "expression": {
            "type": "string"
          },
          "position": {
            "type": "string",
            "description": "Where in frame / relative to camera."
          }
        }
      }
    },
    "environment": {
      "$ref": "common.schema.json#/$defs/environment"
    },
    "camera": {
      "$ref": "common.schema.json#/$defs/camera"
    },
    "lighting": {
      "$ref": "common.schema.json#/$defs/lighting"
    },
    "motion": {
      "$ref": "common.schema.json#/$defs/motion"
    },
    "timeline": {
      "$ref": "common.schema.json#/$defs/timeline"
    },
    "style": {
      "$ref": "common.schema.json#/$defs/style"
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/referenceImage"
          }
        }
      }
    },
    "audio": {
      "$ref": "common.schema.json#/$defs/audio"
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_scene": {
          "$ref": "common.schema.json#/$defs/sceneId"
        },
        "next_scene": {
          "$ref": "common.schema.json#/$defs/sceneId"
        },
        "must_remain_consistent": {
          "$ref": "common.schema.json#/$defs/stringList"
        }
      }
    },
    "constraints": {
      "$ref": "common.schema.json#/$defs/constraints"
    },
    "provenance": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/provenanceBase"
        }
      ],
      "unevaluatedProperties": false
    },
    "notes": {
      "type": "string"
    }
  }
}
