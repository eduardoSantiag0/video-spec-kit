{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character Spec",
  "description": "characters/<id>.yaml — a reusable character referenced by scenes via character_id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "id", "name", "prompt_anchor"],
  "properties": {
    "spec_version": { "$ref": "common.schema.json#/$defs/specVersion" },
    "id": { "$ref": "common.schema.json#/$defs/kebabId" },
    "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "role": { "type": "string" },
    "age": { "type": "string", "description": "Approximate, e.g. 'late 20s'." },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": { "type": "string" },
        "build": { "type": "string" },
        "skin": { "type": "string" }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": { "type": "string" },
        "eyes": { "type": "string" },
        "features": { "type": "string" }
      }
    },
    "hair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "string" },
        "length": { "type": "string" },
        "style": { "type": "string" }
      }
    },
    "wardrobe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outfit": { "type": "string" },
        "colors": { "$ref": "common.schema.json#/$defs/stringList" },
        "accessories": { "$ref": "common.schema.json#/$defs/stringList" }
      }
    },
    "distinctive_features": { "$ref": "common.schema.json#/$defs/stringList" },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "demeanor": { "type": "string" },
        "movement_style": { "type": "string" }
      }
    },
    "expressions": { "$ref": "common.schema.json#/$defs/stringList" },
    "consistency_lock": {
      "$ref": "common.schema.json#/$defs/stringList",
      "description": "Field paths that must stay identical in every scene (e.g. hair.color, wardrobe.outfit)."
    },
    "prompt_anchor": {
      "$ref": "common.schema.json#/$defs/nonEmptyString",
      "description": "Short canonical description (15–35 words) reused VERBATIM in every prompt. Derived from the fields above; regenerate when they change."
    },
    "reference_images": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/referenceImage" } },
    "provenance": {
      "allOf": [{ "$ref": "common.schema.json#/$defs/provenanceBase" }],
      "unevaluatedProperties": false
    },
    "notes": { "type": "string" }
  }
}
